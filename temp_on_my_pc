get_table_for_forest <- function(output_list, gene) {
  
  # Initialize an empty data frame with specified columns
  forest_table <- data.frame(
    dataset = character(),
    sample = character(),
    avg_log2FC = numeric(),
    pct_2 = numeric(),
    CI_lower = numeric(),
    CI_upper = numeric(),
    stringsAsFactors = FALSE
  )
  
  # Loop through datasets in the output_list
  for (dataset_name in names(output_list)) {
    dataset <- output_list[[dataset_name]]
    
    # Loop through samples within the dataset
    for (sample_name in names(dataset)) {
      sample <- dataset[[sample_name]]
      
      # Extract the final_table and check if the gene exists
      final_table <- sample$final_table
      
      if (gene %in% rownames(final_table)) {
        # Gene exists in the final_table, extract the values
        filtered_table <- final_table %>%
          filter(rownames(.) == gene)
        
        # Calculate SE and CI
        avg_log2FC <- filtered_table$avg_log2FC[1]
        p_value <- filtered_table$p_val[1]
        SE <- abs(avg_log2FC) / qnorm(1 - p_value / 2)  # Standard error approximation
        CI_lower <- avg_log2FC - 1.96 * SE
        CI_upper <- avg_log2FC + 1.96 * SE
        
        forest_table <- rbind(
          forest_table,
          data.frame(
            dataset = dataset_name,
            sample = sample_name,
            avg_log2FC = avg_log2FC,
            pct_2 = filtered_table$pct.2[1],
            CI_lower = CI_lower,
            CI_upper = CI_upper,
            stringsAsFactors = FALSE
          )
        )
      } else {
        # Gene does not exist, append default values
        forest_table <- rbind(
          forest_table,
          data.frame(
            dataset = dataset_name,
            sample = sample_name,
            avg_log2FC = NULL,
            pct_2 = 0,
            CI_lower = 0,
            CI_upper = 0,
            stringsAsFactors = FALSE
          )
        )
      }
    }
  }

# a loop for finding the pct.1 

  for (dataset_name in names(output_list)) {
    dataset <- output_list[[dataset_name]]
    
    # Loop through samples within the dataset
    for (sample_name in names(dataset)) {
      sample <- dataset[[sample_name]]
      
      # Extract the final_table and check if the gene exists
      final_table <- sample$final_table
      
      if (gene %in% rownames(final_table)) {
                filtered_table <- final_table %>%
          filter(rownames(.) == gene)
        pct_1 = filtered_table$pct.1[1]
          break
        }
      }
    }
  
  #adding pct_1 for all the rows
  forest_table$pct_1 <- pct_1
  # Return the resulting data frame
  return(forest_table)
}

