create_meta_table <- function(output_list) {
  # Collect all unique genes
  all_genes <- unique(unlist(lapply(output_list, function(dataset) {
    unlist(lapply(dataset, function(sample) {
      rownames(sample$final_table)
    }))
  })))
  
  # Initialize meta_table and required storage
  meta_table <- data.frame(row.names = all_genes)
  gene_count <- numeric(length(all_genes))
  fisher_scores <- setNames(numeric(length(all_genes)), all_genes)
  avg_pct_dif_sums <- setNames(numeric(length(all_genes)), all_genes)
  rank_log2FC_sums <- setNames(numeric(length(all_genes)), all_genes)
  avg_log2FC_sums <- setNames(numeric(length(all_genes)), all_genes)
  significant_counts_threshold <- setNames(numeric(length(all_genes)), all_genes)
  significant_counts_q3 <- setNames(numeric(length(all_genes)), all_genes)
  significant_counts_q3_1_5_iqr <- setNames(numeric(length(all_genes)), all_genes)
  significant_control_counts_threshold <- setNames(numeric(length(all_genes)), all_genes)
  significant_control_counts_q3 <- setNames(numeric(length(all_genes)), all_genes)
  significant_control_counts_q3_1_5_iqr <- setNames(numeric(length(all_genes)), all_genes)
  
  # Precompute Q3 and IQR
  for (dataset in output_list) {
    for (sample in dataset) {
      final_table <- sample$final_table
      final_table$pct_dif <- final_table$pct.1 - final_table$pct.2
      final_table$pct_dif_control <- final_table$pct.2 - final_table$pct.1
      
      q3 <- quantile(final_table$pct_dif, 0.75, na.rm = TRUE)
      iqr <- IQR(final_table$pct_dif, na.rm = TRUE)
      q3_1_5_iqr <- q3 + 1.5 * iqr
      
      q3_control <- quantile(final_table$pct_dif_control, 0.75, na.rm = TRUE)
      iqr_control <- IQR(final_table$pct_dif_control, na.rm = TRUE)
      q3_1_5_iqr_control <- q3_control + 1.5 * iqr_control

      # Rank genes within the current table by avg_log2FC
      if ("avg_log2FC" %in% colnames(final_table)) {
        log2FC_values <- final_table[, "avg_log2FC"]
        ranks <- rank(-log2FC_values, na.last = "keep")  # Descending rank
        names(ranks) <- rownames(final_table)  # Assign gene names to ranks
      }
      
      # Iterate over genes in the table
      for (gene in rownames(final_table)) {
        gene_idx <- match(gene, all_genes)
        
        # Update gene count
        gene_count[gene_idx] <- gene_count[gene_idx] + 1
        
        # Update Fisher scores
        p_val <- final_table[gene, "p_val"]  # Use raw p-values
        if (!is.na(p_val)) {
          fisher_scores[gene] <- fisher_scores[gene] + (-2 * log(p_val))
        }
        
        # Update avg_pct_dif
        pct_dif <- final_table[gene, "pct_dif"]
        if (!is.na(pct_dif)) {
          avg_pct_dif_sums[gene] <- avg_pct_dif_sums[gene] + pct_dif
        }
        
        # Update rank_log2FC
        if (exists("ranks") && !is.na(ranks[gene])) {
          rank_log2FC_sums[gene] <- rank_log2FC_sums[gene] + ranks[gene]
        }
        
        # Update avg_log2FC
        avg_log2FC <- final_table[gene, "avg_log2FC"]
        if (!is.na(avg_log2FC)) {
          avg_log2FC_sums[gene] <- avg_log2FC_sums[gene] + avg_log2FC
        }
        
        # Update significance counts
        pct1 <- final_table[gene, "pct.1"]
        pct2 <- final_table[gene, "pct.2"]
        if (!is.na(pct1) && !is.na(pct_dif)) {
          if (pct1 >= 0.5 && pct_dif >= 0.2) significant_counts_threshold[gene] <- significant_counts_threshold[gene] + 1
          if (pct1 >= 0.5 && pct_dif > q3) significant_counts_q3[gene] <- significant_counts_q3[gene] + 1
          if (pct1 >= 0.5 && pct_dif > q3_1_5_iqr) significant_counts_q3_1_5_iqr[gene] <- significant_counts_q3_1_5_iqr[gene] + 1
        }
        if (!is.na(pct2) && !is.na(final_table[gene, "pct_dif_control"])) {
          pct_dif_control <- final_table[gene, "pct_dif_control"]
          if (pct2 >= 0.5 && pct_dif_control >= 0.2) significant_control_counts_threshold[gene] <- significant_control_counts_threshold[gene] + 1
          if (pct2 >= 0.5 && pct_dif_control > q3_control) significant_control_counts_q3[gene] <- significant_control_counts_q3[gene] + 1
          if (pct2 >= 0.5 && pct_dif_control > q3_1_5_iqr_control) significant_control_counts_q3_1_5_iqr[gene] <- significant_control_counts_q3_1_5_iqr[gene] + 1
        }
      }
    }
  }
  
  # Assign metrics to meta_table
  number_of_samples <- sum(sapply(output_list, function(dataset) length(dataset)))
  
  # Assign Fisher scores and replace Inf values
  meta_table$gene_count <- gene_count
  meta_table$fisher <- round(fisher_scores, 2)
  max_finite_fisher <- max(fisher_scores[is.finite(fisher_scores)], na.rm = TRUE)
  meta_table$fisher[is.infinite(meta_table$fisher)] <- max_finite_fisher + 100
  
  meta_table$avg_pct_dif <- round((avg_pct_dif_sums / gene_count), 2)
  meta_table$rank_log2FC_averge <- round((rank_log2FC_sums / gene_count), 2)
  meta_table$avg_log2FC_averge <- round((avg_log2FC_sums / gene_count), 2)
  meta_table$percent_significant_pct_patient_threshold <- round((significant_counts_threshold / number_of_samples) * 100, 2)
  meta_table$percent_significant_pct_patient_q3 <- round((significant_counts_q3 / number_of_samples) * 100, 2)
  meta_table$percent_significant_pct_patient_q3_1_5_iqr <- round((significant_counts_q3_1_5_iqr / number_of_samples) * 100, 2)
  meta_table$percent_significant_pct_control_threshold <- round((significant_control_counts_threshold / number_of_samples) * 100, 2)
  meta_table$percent_significant_pct_control_q3 <- round((significant_control_counts_q3 / number_of_samples) * 100, 2)
  meta_table$percent_significant_pct_control_q3_1_5_iqr <- round((significant_control_counts_q3_1_5_iqr / number_of_samples) * 100, 2)
  
  return(meta_table)
}

